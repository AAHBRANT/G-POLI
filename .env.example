# Copie para .env e ajuste. NUNCA versionar .env com segredos reais.

# Banco
DATABASE_URL="postgresql://gpol:gpol_dev@localhost:5432/gpoliticas?schema=public"

# Armazenamento de documentos. Em dev, vazio = disco local (pasta uploads/).
# Em produção (Azure), cole a connection string do Storage Account + nome do container.
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="documentos"

# IA — Anthropic (Claude), pela API de Mensagens. Vazio = recursos de IA desligados no app.
# A chave é SEGREDO: em produção, guarde como segredo do Container App; nunca no código.
ANTHROPIC_API_KEY=""
# Opcional: exigido quando a chave não está presa a um workspace da Anthropic.
ANTHROPIC_WORKSPACE_ID=""
# Opcionais (padrões abaixo): modelo de redação e modelo das tarefas curtas.
ANTHROPIC_MODEL="claude-sonnet-5-5"
ANTHROPIC_MODEL_RAPIDO="claude-haiku-5-5"

# Agente de Consulta (bola flutuante "Guuly"): agente e ambiente criados no console da
# Anthropic (Claude Managed Agents). Ambos vazios = a bola não aparece.
ANTHROPIC_AGENTE_CONSULTA_ID=""
ANTHROPIC_AGENTE_CONSULTA_AMBIENTE_ID=""

# ---- Autenticação Microsoft Entra ID ----
# Preencha os quatro campos abaixo + AUTH_SECRET + APP_BASE_URL para ATIVAR login real (web + Teams).
# Para DESLIGAR em dev (preview local sem login), use AUTH_PREVIEW_BYPASS="1" abaixo — não precisa apagar credenciais.
AZURE_AD_TENANT_ID=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
# Application ID URI exposto no Entra (ex.: api://SEU-DOMINIO/CLIENT_ID)
AZURE_AD_APP_ID_URI=""

# Segredo para assinar o cookie de sessão. Gere um valor forte:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# URL base pública do app (usada no redirect do OAuth). Em dev com túnel público: https://SEU-TUNEL
APP_BASE_URL="https://SEU-TUNEL"

# Bootstrap de admin: e-mails (separados por vírgula) que recebem perfil "admin" no 1º login.
# Os demais entram como "colaborador" (nega por padrão). Ex.: "fulano@aahbrant.com,ciclano@aahbrant.com"
ADMIN_EMAILS=""

# Allowlist (modo FECHADO): usada quando ACESSO_ABERTO="0". Ex.: "a@aahbrant.com,b@aahbrant.com"
ALLOWED_EMAILS=""

# Modo de acesso: "1" (padrão) = ABERTO — qualquer e-mail dos DOMINIOS_ORG entra como Colaborador.
# "0" = FECHADO — só entra quem foi convidado (allowlist/registro ativo).
ACESSO_ABERTO="1"
DOMINIOS_ORG="aahbrant.com"

# Dev: "1" DESLIGA a auth para preview local (libera tudo + afinador de perfil no header).
# Vazio ou ausente = auth ligada (comportamento de produção). Nunca usar "1" em produção.
AUTH_PREVIEW_BYPASS=""

# Segredo compartilhado entre o app e o Container Apps Job que dispara a rota
# de cron (/api/cron/lembretes-pendencia). Vazio = rota SEMPRE nega (fail-closed).
# Gere um valor forte (mesmo comando do AUTH_SECRET):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""
