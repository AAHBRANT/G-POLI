    "@vercel/blob": "^2.7.0",
    "docx-templates": "^4.15.0",
    "jose": "^6.2.4",
    "mammoth": "^1.12.0",
    "next": "^14.2.35",
    "pdf-parse": "^2.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jszip": "^3.10.1",
    "postcss": "8.4.40",
    "prisma": "5.17.0",
