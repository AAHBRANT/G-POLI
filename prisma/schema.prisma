// G-Políticas — schema inicial (v1). Fonte: APP-TEC-202.
generator client {
  provider      = "prisma-client-js"
  // native = dev (Windows); debian = runtime do Azure App Service (Linux).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Classificacao {
  publico_interno
  restrito
  confidencial
}

// v3: categoria de documento do PRODUTO — cada uma tem sua seção própria no
// menu (ver lib/constants.ts). Deliberadamente SEM correspondência com os 17
// tipos de documento (TD) oficiais do SGI (MAN, PRO, POL, RGL, CI...): essa
// vinculação foi adiada até o SGI confirmar o mapeamento exato.
enum TipoDocumento {
  politica
  norma
  procedimento
  instrucao_trabalho
  manual
  codigo
  formulario
  comunicado_normativo
}

enum EstadoPolitica {
  rascunho
  publicada
  revogada
}

enum EstadoVersao {
  ativa
  substituida
}

enum EstadoDocumento {
  importado
  processando
  reconhecido
  falhou
  aguardando_acao
}

enum TipoSecao {
  texto
  tabela
}

enum Perfil {
  superadmin // gerencia admins, setores e regras gerais (topo)
  admin // gerencia usuários comuns e vê auditoria
  sgi // dono do conteúdo — edita as 8 seções
  diretoria // aprova e publica
  area // Gestor de Setor — edita seções liberadas + admin restrito ao(s) seu(s) setor(es)
  colaborador // só lê publicada (padrão — nega por padrão)
}

// Setor (RH, TI, Financeiro, Operações…). Antiga "Area" — é o dono da política e agrupa usuários.
model Area {
  id        String     @id @default(cuid())
  nome      String     @unique
  ativa     Boolean    @default(true)
  politicas Politica[]
  usuarios  Usuario[]  @relation("SetorPrincipal") // legado (setor principal / dono da política)
  membros   Usuario[]  @relation("UsuarioSetores") // N:N — usuários vinculados ao setor
  politicasAudiencia Politica[] @relation("PoliticaAudienciaSetores") // v3: setor no público-alvo de quais políticas
  criadoEm  DateTime   @default(now())
}

model Usuario {
  id        String   @id @default(cuid())
  oid       String?  @unique // object id do Entra; null enquanto convidado (ainda não logou)
  email     String   @unique // normalizado em minúsculas; base da allowlist de acesso
  nome      String   @default("")
  perfil    Perfil   @default(colaborador)
  area      Area?    @relation("SetorPrincipal", fields: [areaId], references: [id]) // legado
  areaId    String?
  setores   Area[]   @relation("UsuarioSetores") // N:N — setores do usuário
  ativo     Boolean  @default(true)
  convidadoPor String? // e-mail de quem convidou (auditoria leve)
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt
  politicasAudiencia Politica[] @relation("PoliticaAudienciaUsuarios") // v3: individual no público-alvo de quais políticas
}

model Politica {
  id            String         @id @default(cuid())
  codigo        String?        @unique // código normativo, ex.: POL-RH-001
  titulo        String
  tipo          TipoDocumento  @default(politica) // v3: seção do menu a que pertence
  area          Area           @relation(fields: [areaId], references: [id])
  areaId        String
  classificacao Classificacao
  estado        EstadoPolitica @default(rascunho)
  versoes       Versao[]
  secoes        Secao[]
  criadaEm      DateTime       @default(now())
  publicadaEm   DateTime?
  publicadaPorNome  String?
  publicadaPorEmail String?
  conteudoPublicado Json? // v2: snapshot das seções no momento da publicação (texto oficial congelado)
  revogadaEm    DateTime?
  ciencias      Ciencia[]
  // Público-alvo da notificação de publicação (v3). Os dois vazios = "todos os
  // colaboradores ativos" (comportamento anterior a esta feature, preservado).
  audienciaSetores  Area[]      @relation("PoliticaAudienciaSetores")
  audienciaUsuarios Usuario[]   @relation("PoliticaAudienciaUsuarios")
  notificacoes  Notificacao[]

  // v3: tipo entra na chave — uma Norma e uma Política podem ter o mesmo
  // título na mesma área (são documentos diferentes); só colide dentro do
  // mesmo tipo.
  @@unique([titulo, areaId, tipo])
}

// v3: registro de tentativa de notificação (Teams) por publicação. Auditoria de
// quem foi avisado, quem falhou e por quê — nunca bloqueia a publicação.
model Notificacao {
  id           String   @id @default(cuid())
  politica     Politica @relation(fields: [politicaId], references: [id], onDelete: Cascade)
  politicaId   String
  usuarioEmail String
  usuarioNome  String   @default("")
  enviada      Boolean // true = Graph confirmou (204); false = pulada ou falhou
  motivo       String   @default("") // preenchido só quando enviada = false (ex.: "sem_oid")
  criadoEm     DateTime @default(now())

  @@index([politicaId])
}

// Conteúdo estruturado da política (esqueleto normativo padrão AAHBRANT: seções 1–8).
// v2: ciência de leitura — colaborador confirma que leu a norma publicada.
model Ciencia {
  id           String   @id @default(cuid())
  politica     Politica @relation(fields: [politicaId], references: [id], onDelete: Cascade)
  politicaId   String
  usuarioOid   String
  usuarioNome  String   @default("")
  usuarioEmail String
  criadoEm     DateTime @default(now())

  @@unique([politicaId, usuarioOid])
  @@index([politicaId])
}

// #3c: trilha de auditoria — registro imutável de ações relevantes.
model Auditoria {
  id           String   @id @default(cuid())
  usuarioEmail String
  usuarioNome  String   @default("")
  perfil       String   @default("")
  acao         String // ex.: politica.publicar, secao.salvar, usuario.perfil
  entidade     String // ex.: Politica, Secao, Usuario
  entidadeId   String
  detalhe      String   @default("")
  criadoEm     DateTime @default(now())

  @@index([criadoEm])
  @@index([entidade, entidadeId])
}

// abertaAArea: quando true, o perfil "area" da área dona pode editar esta seção (#3b).
model Secao {
  id          String    @id @default(cuid())
  politica    Politica  @relation(fields: [politicaId], references: [id], onDelete: Cascade)
  politicaId  String
  ordem       Int
  codigo      String // "1".."8"
  titulo      String
  tipo        TipoSecao @default(texto)
  corpo       String    @default("") // usado quando tipo = texto
  colunas     Json? // rótulos das colunas quando tipo = tabela
  linhas      Json? // array de linhas (array de células) quando tipo = tabela
  abertaAArea Boolean  @default(false) // #3b: libera edição para o perfil "area"
  atualizadaEm DateTime @default(now()) @updatedAt

  @@unique([politicaId, codigo])
}

model Versao {
  id         String       @id @default(cuid())
  politica   Politica     @relation(fields: [politicaId], references: [id])
  politicaId String
  numero     Int
  estado     EstadoVersao @default(ativa)
  documento  Documento?
  criadaEm   DateTime     @default(now())

  @@unique([politicaId, numero])
}

model Documento {
  id        String          @id @default(cuid())
  versao    Versao          @relation(fields: [versaoId], references: [id])
  versaoId  String          @unique
  nome      String
  tipo      String
  tamanho   Int
  hash      String          @unique
  estado    EstadoDocumento @default(importado)
  enviadoEm DateTime        @default(now())
}
