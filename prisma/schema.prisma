// G-Políticas — schema inicial (v1). Fonte: APP-TEC-202.
generator client {
  provider      = "prisma-client-js"
  // native = dev (Windows); debian = runtime do Azure App Service (Linux).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Classificacao {
  publico_interno
  restrito
  confidencial
}

// v3: categoria de documento do PRODUTO — cada uma tem sua seção própria no
// menu (ver lib/constants.ts). Mapeamento com os TDs oficiais do SGI (tabela
// "Tipos de Documento" da planilha Codificação de Documentos) confirmado em
// 2026-07-30: politica=POL, procedimento=PRO, instrucao_trabalho=IT,
// manual=MAN, formulario=FOR batem exatamente. `norma` e `codigo` foram
// removidos — a tabela oficial do SGI não tem TD correspondente para eles.
// `comunicado_normativo` fica sem TD oficial equivalente por decisão (o mais
// próximo, Comunicado Interno/CI, usa formato de código incompatível).
enum TipoDocumento {
  politica
  norma
  procedimento
  instrucao_trabalho
  manual
  codigo
  formulario
  comunicado_normativo
}

// Sprint 4/5/6: fluxo de aprovação (modelo B) — substitui o "Diretoria publica
// direto" (modelo A, ver app/(shell)/publicacao/page.tsx) por uma cadeia
// rascunho → em_aprovacao_gestor → em_aprovacao_diretoria → publicada.
// Rejeição em qualquer etapa NÃO é um estado novo — volta pra rascunho (ver
// Politica.rejeitadaEm/motivoRejeicao); estado extra pra isso seria
// equivalente funcional a rascunho, só duplicando lógica de edição/comentário.
enum EstadoPolitica {
  rascunho
  em_aprovacao_gestor
  em_aprovacao_diretoria
  publicada
  revogada
}

enum EstadoVersao {
  ativa
  substituida
}

enum EstadoDocumento {
  importado
  processando
  reconhecido
  falhou
  aguardando_acao
}

enum EstadoPendencia {
  pendente
  resolvida // usuário deu ciência
  cancelada // política revogada antes da ciência, ou pendência superada por republicação
}

enum TipoSecao {
  texto
  tabela
}

enum Perfil {
  superadmin // gerencia admins, setores e regras gerais (topo)
  admin // gerencia usuários comuns e vê auditoria
  sgi // dono do conteúdo — edita as 8 seções
  diretoria // aprova e publica
  area // Gestor de Setor — edita seções liberadas + admin restrito ao(s) seu(s) setor(es)
  colaborador // só lê publicada (padrão — nega por padrão)
}

// Setor (RH, TI, Financeiro, Operações…). Antiga "Area" — é o dono da política e agrupa usuários.
model Area {
  id        String     @id @default(cuid())
  nome      String     @unique
  ativa     Boolean    @default(true)
  politicas Politica[]
  usuarios  Usuario[]  @relation("SetorPrincipal") // legado (setor principal / dono da política)
  membros   Usuario[]  @relation("UsuarioSetores") // N:N — usuários vinculados ao setor
  politicasAudiencia Politica[] @relation("PoliticaAudienciaSetores") // v3: setor no público-alvo de quais políticas
  criadoEm  DateTime   @default(now())
}

// Empresa/consórcio externo (obra em parceria) — dimensão de destino de
// documento independente de Setor interno. Documento com consorcioId
// preenchido só é visível a quem está vinculado a este consórcio (ver
// filtroVisibilidade em lib/auth/rbac.ts).
model Consorcio {
  id        String     @id @default(cuid())
  nome      String     @unique
  ativo     Boolean    @default(true)
  membros   Usuario[]  @relation("UsuarioConsorcios")
  politicas Politica[]
  criadoEm  DateTime   @default(now())
}

model Usuario {
  id        String   @id @default(cuid())
  oid       String?  @unique // object id do Entra; null enquanto convidado (ainda não logou)
  email     String   @unique // normalizado em minúsculas; base da allowlist de acesso
  nome      String   @default("")
  perfil    Perfil   @default(colaborador)
  area      Area?    @relation("SetorPrincipal", fields: [areaId], references: [id]) // legado
  areaId    String?
  setores   Area[]   @relation("UsuarioSetores") // N:N — setores do usuário
  consorcios Consorcio[] @relation("UsuarioConsorcios") // N:N — consórcios externos do usuário
  ativo     Boolean  @default(true)
  convidadoPor String? // e-mail de quem convidou (auditoria leve)
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt
  politicasAudiencia Politica[] @relation("PoliticaAudienciaUsuarios") // v3: individual no público-alvo de quais políticas
  pendencias Pendencia[]
}

model Politica {
  id            String         @id @default(cuid())
  codigo        String?        @unique // código normativo, ex.: POL-RH-001
  titulo        String
  tipo          TipoDocumento  @default(politica) // v3: seção do menu a que pertence
  area          Area           @relation(fields: [areaId], references: [id])
  areaId        String
  // null = AAHBRANT (todos); preenchido = só quem está vinculado a este consórcio (ver spec
  // docs/superpowers/specs/2026-08-02-consorcios-design.md).
  consorcio     Consorcio?     @relation(fields: [consorcioId], references: [id], onDelete: Restrict)
  consorcioId   String?
  classificacao Classificacao
  estado        EstadoPolitica @default(rascunho)
  versoes       Versao[]
  secoes        Secao[]
  criadaEm      DateTime       @default(now())
  publicadaEm   DateTime?
  publicadaPorNome  String?
  publicadaPorEmail String?
  conteudoPublicado Json? // v2: snapshot das seções no momento da publicação (texto oficial congelado)
  // v3: número de revisão do cabeçalho institucional (Manual SGI cap. 11).
  // 0 na primeira publicação; incrementa a cada republicação (reabrir →
  // editar → publicar de novo) — nunca na primeira vez.
  revisao       Int            @default(0)
  revogadaEm    DateTime?
  // Sprint 4/5/6: campos "do ciclo atual" do fluxo de aprovação — mostram só o
  // estado mais recente (limpos a cada novo "enviar para aprovação"), igual
  // revogadaEm já é limpo a cada republicação. O histórico completo e
  // permanente de cada etapa fica na Auditoria (nunca aqui).
  enviadaAprovacaoEm      DateTime?
  enviadaAprovacaoPorNome  String?
  enviadaAprovacaoPorEmail String?
  aprovadaGestorEm        DateTime?
  aprovadaGestorPorNome   String?
  aprovadaGestorPorEmail  String?
  rejeitadaEm      DateTime?
  rejeitadaPorNome String?
  rejeitadaPorEmail String?
  rejeitadaNaEtapa String? // "gestor" | "diretoria" — em qual etapa a última rejeição aconteceu
  motivoRejeicao   String?
  ciencias      Ciencia[]
  pendencias    Pendencia[]
  // Público-alvo da notificação de publicação (v3). Os dois vazios = "todos os
  // colaboradores ativos" (comportamento anterior a esta feature, preservado).
  audienciaSetores  Area[]      @relation("PoliticaAudienciaSetores")
  audienciaUsuarios Usuario[]   @relation("PoliticaAudienciaUsuarios")
  notificacoes  Notificacao[]

  // Etapa 2 (base para a IA): hierarquia documental — o "documento superior" que
  // fundamenta este (política → procedimento → instrução → formulário). Regras
  // de tipo em lib/politica/hierarquia.ts. Se o superior for apagado, o vínculo
  // cai (SetNull) e o documento passa a ser sinalizado como órfão.
  pai           Politica?      @relation("Hierarquia", fields: [paiId], references: [id], onDelete: SetNull)
  paiId         String?
  filhos        Politica[]     @relation("Hierarquia")
  // Prazo de revisão: periodicidade (meses) e a próxima revisão, calculada na
  // publicação (publicadaEm + periodicidade). Ver lib/politica/revisao.ts.
  periodicidadeRevisaoMeses Int       @default(12)
  proximaRevisaoEm          DateTime?

  @@index([paiId])
  @@index([proximaRevisaoEm])

  // v3: tipo entra na chave — uma Norma e uma Política podem ter o mesmo
  // título na mesma área (são documentos diferentes); só colide dentro do
  // mesmo tipo.
  @@unique([titulo, areaId, tipo])
}

// v3: registro de tentativa de notificação (Teams) por publicação. Auditoria de
// quem foi avisado, quem falhou e por quê — nunca bloqueia a publicação.
model Notificacao {
  id           String   @id @default(cuid())
  politica     Politica @relation(fields: [politicaId], references: [id], onDelete: Cascade)
  politicaId   String
  usuarioEmail String
  usuarioNome  String   @default("")
  enviada      Boolean // true = Graph confirmou (204); false = pulada ou falhou
  motivo       String   @default("") // preenchido só quando enviada = false (ex.: "sem_oid")
  criadoEm     DateTime @default(now())

  @@index([politicaId])
}

// Conteúdo estruturado da política (esqueleto normativo padrão AAHBRANT: seções 1–8).
// v2: ciência de leitura — colaborador confirma que leu a norma publicada.
model Ciencia {
  id           String   @id @default(cuid())
  politica     Politica @relation(fields: [politicaId], references: [id], onDelete: Cascade)
  politicaId   String
  usuarioOid   String
  usuarioNome  String   @default("")
  usuarioEmail String
  criadoEm     DateTime @default(now())
  // v3: trilha de auditoria do aceite (Termo de Ciência) — quem, quando, de que
  // IP e para qual versão publicada (comparar com Politica.publicadaEm mostra
  // se a ciência ficou desatualizada após uma republicação).
  ip                   String    @default("")
  politicaPublicadaEm  DateTime?

  @@unique([politicaId, usuarioOid])
  @@index([politicaId])
}

// #3c: trilha de auditoria — registro imutável de ações relevantes.
model Auditoria {
  id           String   @id @default(cuid())
  usuarioEmail String
  usuarioNome  String   @default("")
  perfil       String   @default("")
  acao         String // ex.: politica.publicar, secao.salvar, usuario.perfil
  entidade     String // ex.: Politica, Secao, Usuario
  entidadeId   String
  detalhe      String   @default("")
  criadoEm     DateTime @default(now())

  @@index([criadoEm])
  @@index([entidade, entidadeId])
}

// v3: núcleo de pendência de ciência — materializado (não calculado em
// tempo de leitura) porque o dashboard admin e os lembretes automáticos
// (fases futuras) precisam varrer "todo mundo pendente" em escala.
model Pendencia {
  id                  String          @id @default(cuid())
  politica            Politica        @relation(fields: [politicaId], references: [id], onDelete: Cascade)
  politicaId          String
  usuario             Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId           String
  politicaPublicadaEm DateTime
  tipo                TipoDocumento
  estado              EstadoPendencia @default(pendente)
  criadaEm            DateTime        @default(now())
  resolvidaEm         DateTime?
  notificadaEm        DateTime? // null = toast da Fase B ainda não mostrado
  lembrete3EnviadoEm  DateTime? // null = marco de 3 dias ainda não enviado
  lembrete7EnviadoEm  DateTime? // null = marco de 7 dias ainda não enviado
  lembrete15EnviadoEm DateTime? // null = marco de 15 dias ainda não enviado

  @@unique([politicaId, usuarioId, politicaPublicadaEm])
  @@index([usuarioId, estado])
}

// abertaAArea: quando true, o perfil "area" da área dona pode editar esta seção (#3b).
model Secao {
  id          String    @id @default(cuid())
  politica    Politica  @relation(fields: [politicaId], references: [id], onDelete: Cascade)
  politicaId  String
  ordem       Int
  codigo      String // "1".."8"
  titulo      String
  tipo        TipoSecao @default(texto)
  corpo       String    @default("") // usado quando tipo = texto
  colunas     Json? // rótulos das colunas quando tipo = tabela
  linhas      Json? // array de linhas (array de células) quando tipo = tabela
  abertaAArea Boolean  @default(false) // #3b: libera edição para o perfil "area"
  atualizadaEm DateTime @default(now()) @updatedAt
  comentarios Comentario[]

  @@unique([politicaId, codigo])
}

// Sprint 3: comentário de revisão por parágrafo (estilo Word), com thread de
// respostas e resolver/reabrir. Não edita o conteúdo — é anotação em paralelo.
// paragrafoIndex + trechoAncora: ancora no parágrafo pela posição em
// corpo.split("\n") no momento da criação + um snapshot do texto. Se o
// parágrafo mudar depois, o comentário não se perde — a UI compara o texto
// atual daquele índice com trechoAncora e avisa que mudou, em vez de
// desancorar ou inventar posição nova (mesmo princípio de "nunca perde dado"
// usado em importarDocumento/Controle de Revisões).
model Comentario {
  id             String       @id @default(cuid())
  secao          Secao        @relation(fields: [secaoId], references: [id], onDelete: Cascade)
  secaoId        String
  paragrafoIndex Int
  trechoAncora   String       @default("")
  texto          String
  autorNome      String
  autorEmail     String
  resolvido      Boolean      @default(false)
  resolvidoPorNome String?
  resolvidoEm    DateTime?
  criadoEm       DateTime     @default(now())
  // Thread: null = comentário raiz; preenchido = resposta. Respostas não têm
  // paragrafoIndex/trechoAncora próprios — herdam do pai (ver leituras).
  respostaDeId   String?
  respostaDe     Comentario?  @relation("Respostas", fields: [respostaDeId], references: [id], onDelete: Cascade)
  respostas      Comentario[] @relation("Respostas")

  @@index([secaoId])
  @@index([respostaDeId])
}

model Versao {
  id         String       @id @default(cuid())
  politica   Politica     @relation(fields: [politicaId], references: [id])
  politicaId String
  numero     Int
  estado     EstadoVersao @default(ativa)
  documento  Documento?
  // Snapshot do conteúdo (mesmo formato de Politica.conteudoPublicado) no
  // momento em que ESTA versão foi criada — nunca mais sobrescrito depois,
  // diferente do campo em Politica. Null em versões anteriores a esta
  // feature (não há como recuperar o histórico exato sem abrir o .docx
  // antigo — ver docs/superpowers/specs/2026-08-02-versao-substituida-ver-nao-baixar-design.md).
  conteudoSnapshot Json?
  // Politica.revisao válido no momento em que esta versão foi criada — usado
  // no cabeçalho institucional ao "Ver" uma versão antiga (o número de
  // revisão atual da política pode já ter mudado).
  revisaoNaEpoca   Int?
  // Tabela de Controle de Revisões (Manual, cap. 19) — imutáveis uma vez
  // criados, uma linha por versão. Null em versões anteriores a esta
  // feature (mesmo padrão de conteudoSnapshot/revisaoNaEpoca) — a
  // renderização mostra "—" nessas linhas em vez de inventar dado.
  descricaoAlteracao String?
  responsavelNome    String?
  criadaEm   DateTime     @default(now())

  @@unique([politicaId, numero])
}

model Documento {
  id        String          @id @default(cuid())
  versao    Versao          @relation(fields: [versaoId], references: [id])
  versaoId  String          @unique
  nome      String
  tipo      String
  tamanho   Int
  hash      String          @unique
  estado    EstadoDocumento @default(importado)
  // v3: true = gerado automaticamente na publicação (documento oficial,
  // substitui o anterior a cada republicação); false = anexo manual (ex.:
  // planilha de apoio) - convive com outros anexos, nunca substitui nada.
  oficial   Boolean         @default(false)
  enviadoEm DateTime        @default(now())
}
